# Copy to .env or set these as environment variables BEFORE starting Jupyter. Never commit real keys.
ANTHROPIC_API_KEY=            # needed for the real agent; without it a scripted stand-in runs instead
AGENT_MODEL=claude-opus-5-5   # optional
FRED_API_KEY=                 # optional: without it the public FRED CSV download is used
DATABASE_URL=postgresql://proj@localhost:5433/fraud_copilot
CREDITCARD_CSV=data/creditcard.csv
FP_COST=5                     # assumed cost of one false alarm
